# 复制为 .env 后按需填写。.env 永远不要提交。

# ---- 服务 ----
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# 对外访问地址（用于生成邀请链接、Cookie 安全设置）
PUBLIC_URL=http://localhost:5173
# 服务器部署：填你的域名（如 lab.example.com），deploy/proxy.sh 会让 Caddy 自动签发 HTTPS；同时把 PUBLIC_URL 改成 https://域名
DOMAIN=

# ---- 邮件（找回密码）----
# 发信方式按顺序选：RESEND_API_KEY → SMTP（四项都填）→ 都没配时只把重置链接写进日志
# 重置链接 = ${PUBLIC_URL}/reset-password?token=…，PUBLIC_URL 要填对外域名，不要填服务器 IP
MAIL_FROM="研协 <no-reply@example.com>"
RESEND_API_KEY=
# 例：任意 SMTP 中继 smtp.example.com:587（STARTTLS）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 空 = 按端口推断（465 直连 TLS，其他端口不直连）；true / false 显式指定
SMTP_SECURE=
# 非直连 TLS 时是否强制 STARTTLS（默认 true；false 只用于内网中继，会明文发送）
SMTP_STARTTLS=true
# 会话签名密钥，生产环境必须改成 32 位以上随机串（占位值或过短会拒绝启动），例如 openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# 平台管理员邮箱（逗号分隔）。这些邮箱注册 / 登录后自动成为管理员（后台、免扣费）；
# 注册是开放的，第一个注册的用户不会自动成为管理员。
ADMIN_EMAILS=
# 本地开发：登录做好之前让 /ws 以匿名访客放行（生产环境无效）
REALTIME_DEV_ANON=true
# 部署在 Caddy/Nginx 反代后面时设为 true（Compose 已默认开启）
TRUST_PROXY=false

# ---- 接入：API 令牌（可选，默认关）----
# 打开后可以在「设置 → 接入」里生成令牌（srh_pat_…），外部 agent / 脚本用
#   Authorization: Bearer srh_pat_…
# 调用 /api/v1 下开放的业务接口；角色、项目范围和资源分享权限生效，敏感管理与人工批准仍需网页登录。
# 关掉后所有令牌立刻失效，网页登录不受影响；已生成的令牌随时可在设置里撤销。
API_TOKENS_ENABLED=false
# 每张令牌每分钟的调用上限，超了返回 429（带 Retry-After）
API_TOKENS_RATE_PER_MINUTE=120
# 允许外部 agent 用 MCP 接进来（POST /api/v1/mcp，凭证就是同一张令牌）。
# 需要同时设置 API_TOKENS_ENABLED=true；关掉只影响 MCP，REST 与网页照常。
MCP_ENABLED=false
# 每张令牌每天的业务写入／执行上限，REST 与 MCP 共用且持久化；读操作与临时分块不占额度
MCP_WRITE_PER_DAY=200
# ---- 接入：通知订阅（飞书 / 企业微信 / 钉钉 群机器人，可选，默认关）----
# 打开后可以在「设置 → 通知」里粘贴群机器人 webhook 地址，项目里有事时推到群里。
# 只允许三家官方域名（open.feishu.cn / qyapi.weixin.qq.com / oapi.dingtalk.com），
# 地址里的密钥只写不读（列表只显示打码版）。
NOTIFY_ENABLED=false
# 每人最多几个通知订阅
NOTIFY_MAX_PER_USER=3

# ---- 数据库 ----
# 留空 = 本地开发自动使用嵌入式 PGlite（数据在 .data/pglite），无需安装 Postgres / Docker。
# Docker Compose 下留空即可：自动拼成 postgres://srh:${POSTGRES_PASSWORD}@db:5432/srh
DATABASE_URL=
# ---- 仅 Docker Compose 使用 ----
POSTGRES_PASSWORD=change-me
# 应用发布到宿主机 127.0.0.1 的端口
APP_PORT=8787
# 启动时自动执行迁移（开发、单机部署建议开）
DB_AUTO_MIGRATE=true

# ---- LLM（DeepSeek，OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
# 旧的单模型配置（LLM_MODELS 为空且不是 DeepSeek 官方地址时使用）
LLM_MODEL=deepseek-chat
LLM_MODEL_REASONING=deepseek-reasoner
# 主服务提供的模型（逗号分隔）；DeepSeek 官方地址留空 = deepseek-flash,deepseek-v4-pro
LLM_MODELS=
# 新会话默认模型（<provider>/<model> 或模型名）与推理强度（off/low/medium/high/max）
LLM_DEFAULT_MODEL=
LLM_DEFAULT_EFFORT=high
# 更多 OpenAI 兼容服务（JSON 数组），也可以在 设置 → 模型 里按项目添加。例：
# LLM_PROVIDERS=[{"id":"lab","name":"实验室 vLLM","baseUrl":"http://10.0.0.5:8000/v1","apiKeyEnv":"LAB_KEY","thinkingFormat":"openai","models":["qwen3-72b"]}]
LLM_PROVIDERS=
# agent 上下文预算：模型的上下文窗口（token）和留给回复的 token。换成更小窗口的模型时改小。
AGENT_CONTEXT_TOKENS=128000
AGENT_OUTPUT_RESERVE_TOKENS=16000
# 读图用的视觉模型，写成 <providerId>/<model>（provider 来自上面的 LLM_PROVIDERS 或 设置 → 模型），
# 例：VISION_MODEL=lab/qwen2.5-vl-72b。留空 = 不看图，只用 OCR 识别图里的文字（DeepSeek 没有视觉能力）。
VISION_MODEL=
# OCR 语言包（chi_sim、eng 的 .traineddata）目录。留空 = <STORAGE_DIR>/../ocr-lang。
# Docker Compose 部署固定为 /data/ocr-lang（ocr-lang 卷），重启和重新部署都不会丢。
# 第一次读图时自动下载一次（走 HTTPS_PROXY）；服务器离线时手动把两个文件放进这个目录。
OCR_LANG_DIR=
# 语言包下载地址（{lang} 会被替换成语言名），留空 = jsDelivr 上的 @tesseract.js-data。内网可指向镜像。
OCR_LANG_URL=
# ---- 多模型：OpenRouter（可选）----
# 设了 key 就出现内置 provider openrouter：国内 千问 / GLM / Kimi，国外 Claude / GPT / Gemini。DeepSeek 直连不变、仍是默认。
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- 按量计费（API.md §2.24）----
# 只对平台自带的 deepseek / openrouter 计费，项目自配的 provider 永远不收费。1 积分 = 0.001 美元零售价。
# 关闭时不拦截、不扣费，但用量照常记账。管理员（ADMIN_EMAILS / 后台设的管理员）免扣费。
BILLING_ENABLED=false
# 零售价 = 上游成本 × 倍率（不能小于 1）
BILLING_MARKUP=1.6
# 每个账号一次性赠送的积分
BILLING_SIGNUP_CREDITS=500
# ---- KyrenPay 充值（真钱，没有沙箱；没配 key 时充值入口自动隐藏）----
# webhook 地址：<PUBLIC_URL>/api/v1/billing/kyren-webhook
KYREN_API_KEY=
KYREN_WEBHOOK_SECRET=
KYREN_MERCHANT_NAME=研协

# 允许 stdio 类 MCP 服务器（会在服务器上启动进程，只有负责人 / 导师能添加）
MCP_ALLOW_STDIO=false

# ---- 联网搜索（ARCHITECTURE.md §12）----
# 允许 agent 联网：开启后出现 web_search（通用网页搜索）、paper_search（OpenAlex / Semantic Scholar /
# Crossref / arXiv 学术检索）与 fetch_url（抓取网页或 PDF 正文，拒绝内网地址）。
# 本地开发默认关；Docker Compose 部署默认开（compose 里 AGENT_WEB 默认 true）。旧变量 AGENT_FETCH_URL=true 等同开启。
AGENT_WEB=false
# 自托管 SearXNG。Compose 内自动是 http://searxng:8080；本地开发可留空（退回 DuckDuckGo）
SEARXNG_URL=
# SearXNG 不可用时的退路：duckduckgo | none
WEB_SEARCH_FALLBACK=duckduckgo
# 学术 API 的联系邮箱（OpenAlex / Crossref polite pool，限流更宽松，建议填）
RESEARCH_CONTACT_EMAIL=
# Semantic Scholar API key（可选，https://www.semanticscholar.org/product/api 免费申请；没有时偶尔 429）
SEMANTIC_SCHOLAR_API_KEY=
# 仅 Compose：SearXNG 的密钥，部署脚本会自动生成
SEARXNG_SECRET=

# ---- 文献库（论文解析）----
# 版面解析器：grobid（默认，CPU 即可）| mineru（预留：需要另行部署的 GPU 服务，未验证）
PAPER_PARSER=grobid
# GROBID 服务地址。Docker Compose 下自动指向 grobid 容器；本地开发可用
#   docker run --rm --init -p 8070:8070 grobid/grobid:0.9.1-crf
# 连不上时论文降级为逐页纯文本（能检索、问答，但没有章节/公式/图表结构），并在界面上提示
GROBID_URL=http://localhost:8070
# MinerU 服务地址（PAPER_PARSER=mineru 时使用；当前只是预留接口）
MINERU_URL=
# Crossref / OpenAlex / arXiv 的礼貌访问邮箱（会放进 User-Agent，强烈建议填写）
CROSSREF_MAILTO=
# 单篇解析超时（秒）
PAPER_PARSE_TIMEOUT_SEC=300

# ---- 文件 ----
# 上传文件与项目共享文件夹根目录
STORAGE_DIR=.data/storage
# ---- Notebook 内核（研究空间的 Python 内核）----
# none = 不提供内核（只能编辑）；gateway = 连现成的 Jupyter Kernel Gateway（本地开发）；docker = 每个项目一个隔离容器（生产，compose 默认）
# docker 模式需先构建内核镜像：docker build -t srh-kernel:latest deploy/kernel（镜像名可用 KERNEL_IMAGE 覆盖）
KERNEL_MODE=none
KERNEL_GATEWAY_URL=http://127.0.0.1:8888
# 每个内核容器的资源上限
KERNEL_CPUS=2
KERNEL_MEMORY_MB=2048
# 空闲多少分钟后停掉内核（变量清空，文件保留）；0 = 不停
KERNEL_IDLE_MINUTES=60
# 全服务器同时运行的内核上限：满了先休眠最久没用的空闲内核，都在执行时提示「资源不足」；0 = 不限
KERNEL_MAX_RUNNING=3
# 允许内核访问外网（pip install、下载数据集）
KERNEL_ALLOW_INTERNET=false
